{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.media/schemas/immutable-workload-evidence.v1.schema.json",
  "title": "Codestra immutable workload evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload_id",
    "repository",
    "protected_source_sha",
    "image",
    "image_digest",
    "signature",
    "sbom",
    "provenance",
    "vulnerability_scan",
    "configuration_sha256",
    "rollback_digest",
    "exact_head_ci",
    "independent_review",
    "staging_certification",
    "runtime_identity",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "workload_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "protected_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image": {"type": "string", "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["status", "reference", "subject_image"], "properties": {"status": {"const": "PASS"}, "reference": {"type": "string", "minLength": 12}, "subject_image": {"type": "string", "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$"}}},
    "sbom": {"type": "object", "additionalProperties": false, "required": ["status", "reference", "sha256"], "properties": {"status": {"const": "PASS"}, "reference": {"type": "string", "minLength": 12}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["status", "reference", "subject_image", "source_repository", "source_sha"], "properties": {"status": {"const": "PASS"}, "reference": {"type": "string", "minLength": 12}, "subject_image": {"type": "string", "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$"}, "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "vulnerability_scan": {"type": "object", "additionalProperties": false, "required": ["status", "critical", "high", "reference"], "properties": {"status": {"const": "PASS"}, "critical": {"const": 0}, "high": {"const": 0}, "reference": {"type": "string", "minLength": 12}}},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rollback_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "exact_head_ci": {"const": "PASS"},
    "independent_review": {"const": "PASS"},
    "staging_certification": {"const": "PASS"},
    "runtime_identity": {"type": "object", "additionalProperties": false, "required": ["source_sha_readback", "image_digest_readback"], "properties": {"source_sha_readback": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "image_digest_readback": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["business_writes", "communications_delivery", "provider_effects", "financial_or_trading_mutation"], "properties": {"business_writes": {"const": false}, "communications_delivery": {"const": false}, "provider_effects": {"const": false}, "financial_or_trading_mutation": {"const": false}}}
  }
}
